# Backend server configuration
PORT=5000
WEATHER_API_KEY=your_openweathermap_api_key_here

# Client-side configuration (optional fallback)
# If VITE_WEATHER_API_KEY is provided, the client will make direct API requests to OpenWeatherMap.
# If left commented, the client will proxy all API calls through the Node/Express backend.
# VITE_WEATHER_API_KEY=your_openweathermap_api_key_here
